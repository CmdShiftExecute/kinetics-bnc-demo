# Project Intelligence System demo (kinetics-bnc-demo): static Vite build, tailnet-only HTTPS on port 928.
# This is a TEMPLATE. deploy/install-site.sh renders the __PLACEHOLDERS__ from the host it runs on
# (SITE_HOST/SITE_ADDR from tailscale, SITE_ROOT from the repo, SSL_CERT/SSL_KEY from the short host
# name) and installs the result into /etc/nginx/sites-enabled/kinetics-bnc-demo. Edit here, then
# re-run the installer. Override any value by exporting it before the run.
# The register is about 3 MB of JSON across eight shards, so JSON is gzipped here (the global nginx.conf compresses HTML only).

server {
    listen __SITE_ADDR__:928 ssl;
    server_name __SITE_HOST__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    allow 100.64.0.0/10;
    allow 127.0.0.1;
    deny all;

    root __SITE_ROOT__;
    index index.html;

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 5;

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /data/ {
        expires 5m;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
