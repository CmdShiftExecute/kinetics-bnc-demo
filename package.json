{
  "name": "halvard-pis-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "verticals": "bun scripts/import_verticals.ts",
    "import-bnc": "python3 scripts/import_bnc_data.py",
    "data": "bun run import-bnc && bun scripts/generate_demo_data.ts",
    "test:bnc": "python3 scripts/import_bnc_data.test.py",
    "reconcile": "bun scripts/reconcile.ts",
    "stable": "bun scripts/check_stable.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "contrast": "bun scripts/check_contrast.ts",
    "check": "bun run data && bun run reconcile && bun run stable && bun run typecheck && bun run lint && bun run build && bun run contrast",
    "interactions": "bun scripts/interactions.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "scan": "bash scripts/scan_staged.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
